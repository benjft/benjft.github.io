---
import { getCollection } from 'astro:content';
import ProjectsCarousel from './ProjectsCarousel';

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.dateCreated.getTime() - a.data.dateCreated.getTime());

const projectData = projects
  .filter((p) => p.data.public !== false)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    tagLine: p.data.tagLine,
    tags: p.data.tags,
    thumbnailImage: p.data.thumbnailImage ?? null,
    dateCreated: p.data.dateCreated.toISOString(),
  }));
---

<section id="projects">
  <div class="container">
    <h2>Projects</h2>
    <ProjectsCarousel client:only="react" projects={projectData} />
  </div>
</section>
