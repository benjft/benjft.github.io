---
const skills = [
  'TypeScript',
  'React',
  'Node.js',
  'Python',
  'Go',
  'Docker',
  'PostgreSQL',
  'Git',
];
---

<section id="about">
  <div class="container">
    <h2>About Me</h2>
    <div class="content">
      <div class="bio">
        <p>
          I'm a software engineer passionate about building reliable, well-designed
          software. I enjoy working across the full stack and have a particular
          interest in developer tooling, distributed systems, and great user
          experiences.
        </p>
        <p>
          When I'm not writing code, you'll find me contributing to open source,
          exploring new technologies, or working on personal projects.
        </p>
      </div>
      <div class="skills">
        <h3>Technologies</h3>
        <ul>
          {skills.map((skill) => (
            <li>
              <span class="bullet">▹</span>
              {skill}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    background: var(--color-surface);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .content {
      grid-template-columns: 1fr;
    }
  }

  .bio p + p {
    margin-top: 1rem;
  }

  .skills h3 {
    font-size: 1rem;
    font-family: var(--font-mono);
    color: var(--color-accent-light);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  li {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .bullet {
    color: var(--color-accent-light);
    margin-right: 0.5rem;
  }
</style>
