---
const links = [
  {
    label: 'GitHub',
    href: 'https://github.com/benjft',
    icon: 'github',
  },
  {
    label: 'Email',
    href: 'mailto:hello@example.com',
    icon: 'mail',
  },
];
---

<section id="contact">
  <div class="container">
    <h2>Get In Touch</h2>
    <p>
      I'm always open to interesting conversations and new opportunities. Whether
      you have a project in mind or just want to say hello — my inbox is open.
    </p>
    <div class="links">
      {links.map(({ label, href }) => (
        <a href={href} class="link-btn" target="_blank" rel="noopener noreferrer">
          {label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  #contact {
    background: var(--color-surface);
    text-align: center;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  p {
    margin-top: 1rem;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .link-btn {
    padding: 0.75rem 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.95rem;
    transition: border-color 0.2s, color 0.2s;
    text-decoration: none;
  }

  .link-btn:hover {
    border-color: var(--color-accent-light);
    color: var(--color-accent-light);
    text-decoration: none;
  }
</style>
